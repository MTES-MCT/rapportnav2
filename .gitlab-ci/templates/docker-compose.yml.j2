version: "3.7"

services:
  app:
    image: "{{ docker_image_path_1 }}"
    container_name: rapportnav_backend
    labels:
      io.portainer.accesscontrol.teams: "monitorfish"
    env_file: ".env"
    environment:
      # profile is 'prod', 'int' or 'local'
      - SPRING_PROFILES_ACTIVE
      - ENV_DB_URL
      - DB_USER
      - DB_PASSWORD
      - JWT_SECURITY_KEY
      - MASTER_API_KEY
      - PROXY_HOST
      - PROXY_PORT
      - MONITORFISH_HOST
      - MONITORFISH_API_KEY
      - MONITORENV_HOST
      - SENTRY_DSN
      - SENTRY_SECU_HEADER_ENDPOINT
      # docx -> odt / xlsx -> ods conversions go to the `office-converter` sidecar (default url: http://office-converter:8080/lool/convert-to)
      - OFFICE_MODE=remote
    ports:
      - 80:80
    # volumes:
    #  - "${RAPPORTNAV_LOGS_FOLDER}:/home/rapportnav/logs"
    depends_on:
      db:
        condition: service_started
      office-converter:
        condition: service_healthy
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "1024m"

  # LibreOffice conversion server, only reachable by the app on the compose network (no published port)
  office-converter:
    image: "{{ nexus_proxy }}/jodconverter/jodconverter-examples:rest-4.4.11-1"
    container_name: rapportnav_office_converter
    mem_limit: 1g
    labels:
      io.portainer.accesscontrol.teams: "monitorfish"
    # no curl/wget in the image: probe the REST port with bash's /dev/tcp
    # (Spring Boot only opens the port once LibreOffice has started)
    healthcheck:
      test: [ "CMD", "bash", "-c", "echo > /dev/tcp/127.0.0.1/8080" ]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 60s
    restart: always
    logging:
      driver: "json-file"
      options:
        max-size: "100m"

  db:
    image: "{{ nexus_proxy }}/postgres:15.19-alpine"
    volumes:
      - db:/var/lib/postgresql/data
    restart: always
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: {{ rapportnav_psql_db }}
      POSTGRES_USER: {{ rapportnav_psql_user }}
      POSTGRES_PASSWORD: {{ rapportnav_psql_pwd }}
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U postgres" ]
      interval: 1s
      timeout: 1s
      retries: 30

volumes:
  db:
    name: rapportnavdb


